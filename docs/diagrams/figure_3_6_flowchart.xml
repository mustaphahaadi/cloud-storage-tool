        <mxCell id="edge_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="node_input" target="node_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="node_db" target="node_filter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="node_filter" target="node_decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_no" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#DC2626;fontStyle=1;" edge="1" parent="1" source="node_decision" target="node_error"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_error_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=1.5;" edge="1" parent="1" source="node_error" target="node_end_error"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=1.5;fontColor=#059669;fontStyle=1;" edge="1" parent="1" source="node_decision" target="node_norm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="node_norm" target="node_score"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="node_score" target="node_select"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="node_select" target="node_output"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" parent="1" source="node_output" target="node_end_success"><mxGeometry relative="1" as="geometry"/></mxCell>
