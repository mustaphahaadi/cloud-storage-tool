  <diagram id="conceptual-framework" name="Figure 1 Conceptual Framework">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Figure 1: Conceptual Framework of Parameter Relationships &amp; Decision Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="570" height="30" as="geometry" />
        </mxCell>

        <!-- Box 1: Input Parameters -->
        <mxCell id="box1" value="INPUT APPLICATION REQUIREMENTS &amp; PRIORITY WEIGHTS&lt;br/&gt;&amp;bull; L_req (Max Latency in ms) &amp;bull; A_req (Minimum Availability SLA %)&lt;br/&gt;&amp;bull; B (Budget Limit in $, optional) &amp;bull; Alpha (Cost Optimization Weight, 0 &amp;le; Alpha &amp;le; 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="650" height="70" as="geometry" />
        </mxCell>

        <!-- Box 2: Hard Constraint Filtering -->
        <mxCell id="box2" value="PHASE 1: HARD FEASIBILITY CONSTRAINT FILTERING&lt;br/&gt;Feasible Set F = { i &amp;isin; T | A(i) &amp;ge; A_req AND L(i) &amp;le; L_req AND C(i) &amp;le; B }&lt;br/&gt;(If F is empty &amp;rarr; Terminate with Feasibility Exception)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="650" height="75" as="geometry" />
        </mxCell>

        <!-- Box 3: Normalization & Dual Scoring -->
        <mxCell id="box3" value="PHASE 2: METRIC NORMALIZATION &amp; DUAL-OBJECTIVE SCORING&lt;br/&gt;1. Convert Availability to Unavailability: U(i) = 1.0 - (A(i) / 100.0)&lt;br/&gt;2. Compute Min-Max Scaled Norms: C_norm(i) &amp; U_norm(i) &amp;isin; [0.0, 1.0]&lt;br/&gt;3. Evaluate Score(i) = Alpha &amp;times; C_norm(i) + (1.0 - Alpha) &amp;times; U_norm(i)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="295" width="650" height="85" as="geometry" />
        </mxCell>

        <!-- Box 4: Optimal Selection -->
        <mxCell id="box4" value="PHASE 3: OPTIMAL SELECTION &amp; BASELINE LOGGING&lt;br/&gt;Winning Tier i* = argmin_{i &amp;isin; F} Score(i) &amp;rarr; Output Recommendation &amp;amp; Log to SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="650" height="65" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="box1" target="box2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="box2" target="box3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4338CA;strokeWidth=2;" edge="1" parent="1" source="box3" target="box4"><mxGeometry relative="1" as="geometry"/></mxCell>
