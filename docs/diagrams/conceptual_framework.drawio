<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-27T12:00:00.000Z" version="21.6.8" type="device">
  <diagram id="conceptual_framework" name="Figure 1 Conceptual Framework">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Figure 1: Conceptual Framework of Parameter Relationships &amp; Decision Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="570" height="30" as="geometry" />
        </mxCell>

        <mxCell id="box1" value="INPUT APPLICATION REQUIREMENTS &amp; PRIORITY WEIGHTS&#10;&#8226; L_req (Max Latency in ms) &#8226; A_req (Minimum Availability SLA %)&#10;&#8226; B (Budget Limit in $, optional) &#8226; Alpha (Cost Optimization Weight, 0 &lt;= Alpha &lt;= 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="650" height="70" as="geometry" />
        </mxCell>

        <mxCell id="box2" value="PHASE 1: HARD FEASIBILITY CONSTRAINT FILTERING&#10;Feasible Set E = { i &#8712; T | A(i) &gt;= A_req AND L(i) &lt;= L_req AND C(i) &lt;= B }&#10;(If E is empty &#8594; Terminate with Feasibility Exception)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="650" height="75" as="geometry" />
        </mxCell>

        <mxCell id="box3" value="PHASE 2: METRIC NORMALIZATION &amp; DUAL-OBJECTIVE SCORING&#10;1. Convert Availability to Unavailability: U(i) = 1.0 - (A(i) / 100.0)&#10;2. Compute Min-Max Scaled Norms: C_norm(i) &amp; U_norm(i) &#8712; [0.0, 1.0]&#10;3. Evaluate Score(i) = Alpha &#215; C_norm(i) + (1.0 - Alpha) &#215; U_norm(i)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="295" width="650" height="85" as="geometry" />
        </mxCell>

        <mxCell id="box4" value="PHASE 3: OPTIMAL SELECTION &amp; BASELINE LOGGING&#10;Winning Tier i* = argmin_{i &#8712; E} Score(i) &#8594; Output Recommendation &amp; Log to SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="650" height="65" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" parent="1" source="box1" target="box2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;" edge="1" parent="1" source="box2" target="box3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4338CA;strokeWidth=2;" edge="1" parent="1" source="box3" target="box4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>