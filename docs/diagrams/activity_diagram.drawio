<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-27T13:00:00.000Z" version="21.6.8" type="device">
  <diagram id="activity_diagram" name="Figure 3.6 Activity Diagram Operational Flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="title" value="Figure 3.6: Activity Diagram for Operational Storage Resource Allocation Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Initial Node -->
        <mxCell id="a_init" value="" style="ellipse;html=1;shape=endState;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Activity 1 -->
        <mxCell id="a1" value="Storage Admin enters S_req, A_req, L_req, Budget, and &#945;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="130" width="290" height="50" as="geometry" />
        </mxCell>

        <!-- Activity 2 -->
        <mxCell id="a2" value="System retrieves 6 active storage tiers from SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="275" y="210" width="280" height="45" as="geometry" />
        </mxCell>

        <!-- Decision Diamond -->
        <mxCell id="adec1" value="Pre-filtering check:&#10;Availability &gt;= A_req AND&#10;Latency &lt;= L_req AND&#10;Cost &lt;= Budget?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="285" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Activity Exception -->
        <mxCell id="aerr" value="Display Feasibility Exception Dialog&#10;(No Compliant Tier Found)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="312.5" width="210" height="45" as="geometry" />
        </mxCell>

        <!-- Activity 3: Min-Max -->
        <mxCell id="a3" value="Calculate Min-Max Scaled Norms: C_norm and U_norm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="260" y="420" width="310" height="45" as="geometry" />
        </mxCell>

        <!-- Activity 4: Score -->
        <mxCell id="a4" value="Evaluate Score(i) = &#945; C_norm(i) + &#946; U_norm(i) for eligible tiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="245" y="495" width="340" height="45" as="geometry" />
        </mxCell>

        <!-- Activity 5: Select -->
        <mxCell id="a5" value="Select Tier i* minimizing Score and commit record to SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="570" width="330" height="45" as="geometry" />
        </mxCell>

        <!-- Final Node -->
        <mxCell id="a_final" value="" style="ellipse;html=1;shape=endState;fillColor=#059669;strokeColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="400" y="650" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="e_1" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="a_init" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_2" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_3" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="a2" target="adec1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_no" value="NO" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#DC2626;fontColor=#DC2626;fontStyle=1;" edge="1" parent="1" source="adec1" target="aerr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_yes" value="YES" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#059669;fontColor=#059669;fontStyle=1;" edge="1" parent="1" source="adec1" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_4" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_5" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_6" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="a5" target="a_final"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
